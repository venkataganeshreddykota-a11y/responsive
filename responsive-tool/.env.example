SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=responsive_tool
DB_USER=root
DB_PASSWORD=@Ganesh12345
DB_HOST=localhost
DB_PORT=3306
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Drive integration
# Absolute path to your downloaded Service Account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/your/service-account.json
# Google Drive folder ID to upload screenshots into (leave empty for Drive root)
GDRIVE_SCREENSHOTS_FOLDER_ID=your_folder_id_here

# Google OAuth (for user-level Drive access — "Save to Drive" button)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/scanner/gdrive/callback/
FRONTEND_URL=http://localhost:3000
