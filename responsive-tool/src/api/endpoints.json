{
  "base_url": "http://localhost:8000",
  "endpoints": [
    { "method": "POST", "path": "/api/auth/token/",         "auth": false, "description": "Obtain JWT tokens" },
    { "method": "POST", "path": "/api/auth/token/refresh/", "auth": false, "description": "Refresh access token" },
    { "method": "POST", "path": "/api/users/register/",     "auth": false, "description": "Register new user" },
    { "method": "GET",  "path": "/api/users/me/",           "auth": true,  "description": "Get current user" },
    { "method": "GET",  "path": "/api/scanner/urls/",       "auth": true,  "description": "List scan URLs" },
    { "method": "POST", "path": "/api/scanner/scan/",       "auth": true,  "description": "Trigger scan" },
    { "method": "GET",  "path": "/api/scanner/scan/{id}/status/", "auth": true, "description": "Poll scan status" }
  ]
}
